# Kopiere diese Datei nach ".env" und passe sie bei Bedarf an.
# Für die lokale Entwicklung funktionieren die Standardwerte ohne Änderung.

# Port, auf dem der Server läuft
PORT=3000

# development | production
# In "production" werden u.a. Cookies mit "Secure"-Flag gesetzt (erfordert HTTPS!)
NODE_ENV=development

# Pfad zur SQLite-Datenbankdatei (nur relevant, wenn DATABASE_URL NICHT gesetzt ist)
DB_PATH=./data/ark-tribe-hub.db

# Gesetzt = Postgres statt SQLite (z.B. auf Render). Render setzt dies automatisch,
# wenn eine Postgres-Datenbank mit dem Web Service verbunden ist - lokal leer lassen.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Geheimnis für abgeleitete Tokens (CSRF). Lokal wird bei Bedarf automatisch eines in
# data/.session-secret erzeugt. Auf Hosting OHNE persistente Festplatte (z.B. Render
# Free Tier) MUSS diese Variable gesetzt sein, sonst würde jeder Neustart ein neues
# Geheimnis erzeugen und alle offenen Sessions beim nächsten Seiten-Reload aussperren.
# Render setzt dies über render.yaml automatisch (generateValue: true).
# SESSION_SECRET=

# Ordner für hochgeladene Bilder (Avatare, Item-Bilder)
UPLOAD_DIR=./data/uploads

# Erlaubte Frontend-Origin für CORS (mehrere durch Komma getrennt), z.B. http://localhost:5173
# Leer lassen = im Development-Modus werden alle http://localhost:* Origins erlaubt
CORS_ORIGINS=

# Session-Gültigkeit in Tagen (persistente Session)
SESSION_TTL_DAYS=30
