{
  "name": "ark-tribe-hub-backend",
  "version": "1.0.0",
  "description": "ARK Tribe Hub – Multi-Tribe Organisationsplattform (Backend: API, Datenbank, Auth, Berechtigungen)",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --no-warnings src/server.js",
    "start": "node --no-warnings src/server.js",
    "seed": "node --no-warnings src/db/seed.js",
    "test": "node --no-warnings --test test/run.mjs test/community.mjs test/new-features.mjs test/ui-regressions.mjs",
    "test:postgres": "node --test test/postgres-schema.mjs"
  },
  "dependencies": {
    "pg": "^8.13.0",
    "nodemailer": "10.0.1"
  },
  "devDependencies": { "@electric-sql/pglite": "0.5.8" }
}
